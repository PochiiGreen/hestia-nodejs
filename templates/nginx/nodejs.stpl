#=========================================================================#
# Hestia Control Panel - Node.js HTTPS / SSL Reverse Proxy Template       #
# Author: pochii-dev / PochiiGreen (https://github.com/PochiiGreen)       #
# Handles any dynamic port ($node_port via nodeport.conf) & WebSockets    #
#=========================================================================#

server {
    listen      %ip%:%web_ssl_port% ssl;
    server_name %domain_idn% %alias_idn%;
    root        %sdocroot%;
    index       index.html index.htm;
    access_log  /var/log/%web_system%/domains/%domain%.log combined;
    access_log  /var/log/%web_system%/domains/%domain%.bytes bytes;
    error_log   /var/log/%web_system%/domains/%domain%.error.log error;

    # SSL Certificates managed by HestiaCP / Let's Encrypt
    ssl_certificate     %ssl_pem%;
    ssl_certificate_key %ssl_key%;
    ssl_stapling        on;
    ssl_stapling_verify on;

    include %home%/%user%/conf/web/%domain%/nginx.hsts.conf*;

    # Deny access to hidden files/directories (except .well-known for ACME/SSL)
    location ~ /\.(?!well-known\/|file) {
        deny all;
        return 404;
    }

    # Static assets direct caching - served by Nginx if file exists
    location ~* ^.+\.(jpg|jpeg|gif|png|ico|svg|css|zip|tgz|gz|rar|bz2|doc|xls|exe|pdf|ppt|txt|tar|mid|midi|wav|bmp|rtf|js|flv|swf|woff|woff2|ttf|eot)$ {
        root %sdocroot%;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri @nodejs_app;
    }

    # Main application routing
    location / {
        try_files $uri @nodejs_app;
    }

    # Proxy to Node.js / PM2 Backend
    location @nodejs_app {
        # Default port 3000, dynamically overridden by domain nodeport.conf
        set $node_port 3000;
        include %home%/%user%/conf/web/%domain%/nodeport.conf*;

        proxy_pass         http://127.0.0.1:$node_port;
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;

        # Proxy Headers
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Port $server_port;
        proxy_set_header   X-Forwarded-Host $host;

        # Production buffer & timeout configurations
        proxy_connect_timeout 60s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_cache_bypass    $http_upgrade;
        proxy_buffering       off;
    }

    location /error/ {
        alias %home%/%user%/web/%domain%/document_errors/;
    }

    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
