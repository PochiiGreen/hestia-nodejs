#!/bin/bash
# info: configure nodejs app and pm2 for a web domain in hestiacp
# options: USER DOMAIN [PORT] [APP_NAME] [STARTUP_FILE] [PKG_MGR] [APP_TEMPLATE] [NODE_ENV] [INSTANCES] [AUTO_START]
#
# author: pochii-dev / PochiiGreen (https://github.com/PochiiGreen)
# example: v-add-web-domain-nodejs admin example.com 3041 myapp app.js pnpm express production 1 yes

#----------------------------------------------------------#
#                    Variable & Config                     #
#----------------------------------------------------------#

user="$1"
domain="$2"
port="${3:-3000}"
app_name="${4:-node-$domain}"
startup_file="${5:-app.js}"
pkg_mgr="${6:-pnpm}"
app_template="${7:-express}"
node_env="${8:-production}"
instances="${9:-1}"
auto_start="${10:-yes}"

# Sanitize app name
app_name=$(echo "$app_name" | tr -cd 'a-zA-Z0-9_-')
[ -z "$app_name" ] && app_name="node-$domain"

# Sanitize port (supports ANY port e.g. 3041, 4000, 8080)
port=$(echo "$port" | tr -cd '0-9')
[ -z "$port" ] && port="3000"

# Sanitize package manager (pnpm, npm, yarn)
case "$pkg_mgr" in
    pnpm|npm|yarn) ;;
    *) pkg_mgr="pnpm" ;;
esac

# Include Hestia functions if available
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f /usr/local/hestia/func/main.sh ] && source /usr/local/hestia/func/main.sh
# shellcheck source=/usr/local/hestia/conf/hestia.conf
[ -f /usr/local/hestia/conf/hestia.conf ] && source /usr/local/hestia/conf/hestia.conf

#----------------------------------------------------------#
#                    Validation Checks                     #
#----------------------------------------------------------#

if [ -z "$user" ] || [ -z "$domain" ]; then
    echo "Error: USER and DOMAIN are required."
    echo "Usage: v-add-web-domain-nodejs USER DOMAIN [PORT] [APP_NAME] [STARTUP_FILE] [PKG_MGR] [TEMPLATE] [ENV] [INSTANCES] [AUTO_START]"
    exit 1
fi

if ! id "$user" >/dev/null 2>&1; then
    echo "Error: System user '$user' does not exist."
    exit 2
fi

web_dir="/home/$user/web/$domain"
doc_root="$web_dir/public_html"
conf_dir="/home/$user/conf/web/$domain"
logs_dir="$web_dir/logs"
starters_dir="/usr/local/hestia/data/templates/starters/nodejs"

if [ ! -d "$web_dir" ]; then
    echo "Error: Domain directory '$web_dir' not found."
    exit 3
fi

mkdir -p "$logs_dir" "$conf_dir" "$doc_root"

#----------------------------------------------------------#
#              Step 1: Configure Nginx Port                #
#----------------------------------------------------------#

cat <<EOF > "$conf_dir/nodeport.conf"
# Node.js reverse proxy port mapping for $domain
set \$node_port $port;
EOF
chown "$user:$user" "$conf_dir/nodeport.conf"
chmod 644 "$conf_dir/nodeport.conf"

# Apply nodejs template in Hestia if command exists
if [ -x "/usr/local/hestia/bin/v-change-web-domain-tpl" ]; then
    /usr/local/hestia/bin/v-change-web-domain-tpl "$user" "$domain" "nodejs" "no" >/dev/null 2>&1 || true
fi

#----------------------------------------------------------#
#              Step 2: Starter Boilerplate                 #
#----------------------------------------------------------#

if [ ! -f "$doc_root/package.json" ]; then
    case "$app_template" in
        fastify)
            if [ -d "$starters_dir/fastify" ]; then
                cp -r "$starters_dir/fastify/"* "$doc_root/"
            else
                cat <<'EOF' > "$doc_root/package.json"
{
  "name": "fastify-app",
  "version": "1.0.0",
  "author": "pochii-dev",
  "main": "app.js",
  "scripts": { "start": "node app.js" },
  "dependencies": { "dotenv": "^16.4.5", "fastify": "^4.26.2" }
}
EOF
                cat <<'EOF' > "$doc_root/app.js"
require('dotenv').config();
const Fastify = require('fastify');
const fastify = Fastify({ logger: false });
const PORT = parseInt(process.env.PORT, 10) || 3000;

fastify.get('/health', async () => ({ status: 'healthy', uptime: process.uptime() }));
fastify.get('/api/status', async () => ({ app: process.env.APP_NAME, port: PORT, status: 'online' }));
fastify.get('/', async (req, reply) => {
    reply.type('text/html').send('<h1>⚡ Fastify running on HestiaCP</h1><p>Port: ' + PORT + '</p>');
});

fastify.listen({ port: PORT, host: '127.0.0.1' }, (err) => {
    if (err) process.exit(1);
    console.log(`Server listening on port ${PORT}`);
});
EOF
            fi
            ;;

        minimal)
            if [ -d "$starters_dir/minimal" ]; then
                cp -r "$starters_dir/minimal/"* "$doc_root/"
            else
                cat <<'EOF' > "$doc_root/package.json"
{
  "name": "minimal-node-app",
  "version": "1.0.0",
  "author": "pochii-dev",
  "main": "app.js",
  "scripts": { "start": "node app.js" }
}
EOF
                cat <<'EOF' > "$doc_root/app.js"
const http = require('http');
const PORT = parseInt(process.env.PORT, 10) || 3000;
const server = http.createServer((req, res) => {
    if (req.url === '/health') {
        res.writeHead(200, { 'Content-Type': 'application/json' });
        return res.end(JSON.stringify({ status: 'ok', uptime: process.uptime() }));
    }
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
    res.end('<h1>🟢 Native Node.js running on HestiaCP</h1><p>Port: ' + PORT + '</p>');
});
server.listen(PORT, '127.0.0.1', () => console.log(`Listening on ${PORT}`));
EOF
            fi
            ;;

        blank)
            if [ ! -f "$doc_root/$startup_file" ]; then
                cat <<EOF > "$doc_root/$startup_file"
const http = require('http');
const PORT = process.env.PORT || $port;
http.createServer((req, res) => {
    res.writeHead(200, { 'Content-Type': 'text/plain' });
    res.end('Node.js app on HestiaCP running on port ' + PORT);
}).listen(PORT, '127.0.0.1');
EOF
            fi
            ;;

        express|*)
            if [ -d "$starters_dir/express" ]; then
                cp -r "$starters_dir/express/"* "$doc_root/"
            else
                mkdir -p "$doc_root/public"
                cat <<'EOF' > "$doc_root/package.json"
{
  "name": "express-app",
  "version": "1.0.0",
  "author": "pochii-dev",
  "main": "app.js",
  "scripts": { "start": "node app.js" },
  "dependencies": { "dotenv": "^16.4.5", "express": "^4.19.2" }
}
EOF
                cat <<'EOF' > "$doc_root/app.js"
require('dotenv').config();
const express = require('express');
const app = express();
const PORT = process.env.PORT || 3000;

app.get('/health', (req, res) => res.json({ status: 'healthy', uptime: process.uptime() }));
app.get('/api/status', (req, res) => res.json({ app: process.env.APP_NAME, port: PORT, status: 'online' }));
app.get('/', (req, res) => res.send('<h1>🚀 Express app on HestiaCP</h1><p>Port: ' + PORT + '</p>'));

app.listen(PORT, '127.0.0.1', () => console.log(`Running on port ${PORT}`));
EOF
            fi
            ;;
    esac
fi

# Ensure startup file exists if different name specified
if [ ! -f "$doc_root/$startup_file" ] && [ -f "$doc_root/app.js" ]; then
    if [ "$startup_file" != "app.js" ]; then
        mv "$doc_root/app.js" "$doc_root/$startup_file"
    fi
fi

#----------------------------------------------------------#
#              Step 3: Environment (.env)                  #
#----------------------------------------------------------#

if [ ! -f "$doc_root/.env" ]; then
    cat <<EOF > "$doc_root/.env"
PORT=$port
NODE_ENV=$node_env
DOMAIN=$domain
APP_NAME=$app_name
EOF
fi

#----------------------------------------------------------#
#              Step 4: Ecosystem File (PM2)                #
#----------------------------------------------------------#

exec_mode="fork"
if [ "$instances" = "max" ] || [ "$instances" -gt 1 ] 2>/dev/null; then
    exec_mode="cluster"
fi

cat <<EOF > "$doc_root/ecosystem.config.js"
module.exports = {
  apps: [
    {
      name: '$app_name',
      script: '$startup_file',
      cwd: '$doc_root',
      instances: '$instances',
      exec_mode: '$exec_mode',
      autorestart: true,
      watch: false,
      max_memory_restart: '500M',
      env: {
        NODE_ENV: '$node_env',
        PORT: $port,
        DOMAIN: '$domain',
        APP_NAME: '$app_name'
      },
      error_file: '$logs_dir/$app_name-error.log',
      out_file: '$logs_dir/$app_name-out.log',
      log_date_format: 'YYYY-MM-DD HH:mm:ss Z',
      merge_logs: true
    }
  ]
};
EOF

# Provide ecosystem.config.cjs for projects with "type": "module" in package.json
cp -f "$doc_root/ecosystem.config.js" "$doc_root/ecosystem.config.cjs"

#----------------------------------------------------------#
#              Step 5: Install Dependencies (PNPM/NPM)     #
#----------------------------------------------------------#

chown -R "$user:$user" "$doc_root" "$logs_dir"
chmod 755 "$doc_root"

if [ -f "$doc_root/package.json" ] && [ "$app_template" != "minimal" ] && [ "$app_template" != "blank" ]; then
    case "$pkg_mgr" in
        pnpm)
            if ! command -v pnpm >/dev/null 2>&1; then
                npm install -g pnpm --loglevel=error >/dev/null 2>&1 || true
            fi
            if command -v pnpm >/dev/null 2>&1; then
                echo "Installing dependencies using pnpm for $app_name..."
                su - "$user" -s /bin/bash -c "cd '$doc_root' && pnpm install --prod" >/dev/null 2>&1 || true
            else
                echo "Falling back to npm install for $app_name..."
                su - "$user" -s /bin/bash -c "cd '$doc_root' && npm install --no-audit --no-fund" >/dev/null 2>&1 || true
            fi
            ;;
        yarn)
            if ! command -v yarn >/dev/null 2>&1; then
                npm install -g yarn --loglevel=error >/dev/null 2>&1 || true
            fi
            su - "$user" -s /bin/bash -c "cd '$doc_root' && yarn install --production" >/dev/null 2>&1 || true
            ;;
        npm|*)
            if command -v npm >/dev/null 2>&1; then
                echo "Installing dependencies using npm for $app_name..."
                su - "$user" -s /bin/bash -c "cd '$doc_root' && npm install --no-audit --no-fund" >/dev/null 2>&1 || true
            fi
            ;;
    esac
fi

chown -R "$user:$user" "$doc_root"

#----------------------------------------------------------#
#              Step 6: PM2 Service & Immediate Start       #
#----------------------------------------------------------#

if command -v pm2 >/dev/null 2>&1; then
    # Ensure systemd service is active for this user
    pm2 startup systemd -u "$user" --hp "/home/$user" >/dev/null 2>&1 || true
    systemctl enable "pm2-$user" >/dev/null 2>&1 || true
    systemctl start "pm2-$user" >/dev/null 2>&1 || true

    if [ "$auto_start" = "yes" ]; then
        echo "Starting PM2 application '$app_name' immediately..."
        su - "$user" -s /bin/bash -c "pm2 delete '$app_name' 2>/dev/null || true"
        su - "$user" -s /bin/bash -c "cd '$doc_root' && pm2 start ecosystem.config.js"
        su - "$user" -s /bin/bash -c "pm2 save"
    fi
fi

#----------------------------------------------------------#
#              Step 7: Rebuild & Reload Nginx              #
#----------------------------------------------------------#

if [ -x "/usr/local/hestia/bin/v-rebuild-web-domain" ]; then
    /usr/local/hestia/bin/v-rebuild-web-domain "$user" "$domain" "no" >/dev/null 2>&1 || true
fi

if systemctl is-active --quiet nginx; then
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
fi

echo "Success: Node.js application '$app_name' configured on port $port and running with PM2."
exit 0
