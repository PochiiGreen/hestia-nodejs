#!/bin/bash
# info: configure nodejs app and pm2 for a web domain in hestiacp
# options: USER DOMAIN [PORT] [APP_NAME] [STARTUP_FILE] [PKG_MGR] [APP_TEMPLATE] [NODE_ENV] [INSTANCES] [AUTO_START]
#
# author: pochii-dev / PochiiGreen (https://github.com/PochiiGreen)
# example: v-add-web-domain-nodejs admin example.com 3041 myapp app.js pnpm express production 1 yes

#----------------------------------------------------------#
#                    Variable & Config                     #
#----------------------------------------------------------#

user="$1"
domain="$2"
port="${3:-3000}"
app_name="${4:-node-$domain}"
startup_file="${5:-app.js}"
pkg_mgr="${6:-pnpm}"
app_template="${7:-express}"
node_env="${8:-production}"
instances="${9:-1}"
auto_start="${10:-yes}"

# Sanitize app name
app_name=$(echo "$app_name" | tr -cd 'a-zA-Z0-9_-')
[ -z "$app_name" ] && app_name="node-$domain"

# Sanitize port (supports ANY port e.g. 3041, 4000, 8080)
port=$(echo "$port" | tr -cd '0-9')
[ -z "$port" ] && port="3000"

# Sanitize package manager (pnpm, npm, yarn)
case "$pkg_mgr" in
    pnpm|npm|yarn) ;;
    *) pkg_mgr="pnpm" ;;
esac

# Include Hestia functions if available
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f /usr/local/hestia/func/main.sh ] && source /usr/local/hestia/func/main.sh
# shellcheck source=/usr/local/hestia/conf/hestia.conf
[ -f /usr/local/hestia/conf/hestia.conf ] && source /usr/local/hestia/conf/hestia.conf

#----------------------------------------------------------#
#                    Validation Checks                     #
#----------------------------------------------------------#

if [ -z "$user" ] || [ -z "$domain" ]; then
    echo "Error: USER and DOMAIN are required."
    echo "Usage: v-add-web-domain-nodejs USER DOMAIN [PORT] [APP_NAME] [STARTUP_FILE] [PKG_MGR] [TEMPLATE] [ENV] [INSTANCES] [AUTO_START]"
    exit 1
fi

if ! id "$user" >/dev/null 2>&1; then
    echo "Error: System user '$user' does not exist."
    exit 2
fi

web_dir="/home/$user/web/$domain"
app_dir="$web_dir/public_html"
doc_root="$web_dir/public_html"
conf_dir="/home/$user/conf/web/$domain"
logs_dir="$web_dir/logs"
starters_dir="/usr/local/hestia/data/templates/starters/nodejs"

if [ ! -d "$web_dir" ]; then
    echo "Error: Domain directory '$web_dir' not found."
    exit 3
fi

# Ensure all target directories exist
mkdir -p "$logs_dir" "$conf_dir" "$app_dir"

#----------------------------------------------------------#
#              Step 1: Configure Nginx Port                #
#----------------------------------------------------------#

cat <<EOF > "$conf_dir/nodeport.conf"
# Node.js backend port mapping for $domain
set \$backend_port $port;
EOF
chown "$user:$user" "$conf_dir/nodeport.conf"
chmod 644 "$conf_dir/nodeport.conf"

# Apply nodejs template in Hestia according to the web stack
if [ -f "/usr/local/hestia/conf/hestia.conf" ] && grep -q "WEB_SYSTEM='apache2'" /usr/local/hestia/conf/hestia.conf; then
    # In Apache2 + Nginx setups, nodejs template belongs to Nginx Proxy
    if [ -x "/usr/local/hestia/bin/v-change-web-domain-proxy-tpl" ]; then
        /usr/local/hestia/bin/v-change-web-domain-proxy-tpl "$user" "$domain" "nodejs" "no" >/dev/null 2>&1 || true
    fi
else
    # In standalone Nginx setups (without Apache), nodejs template belongs to Web Template
    if [ -x "/usr/local/hestia/bin/v-change-web-domain-tpl" ]; then
        /usr/local/hestia/bin/v-change-web-domain-tpl "$user" "$domain" "nodejs" "no" >/dev/null 2>&1 || true
    fi
fi

#----------------------------------------------------------#
#       Step 2: Clean Up & Consolidate in public_html      #
#----------------------------------------------------------#

# If files were previously in private/nodeapp, migrate them to public_html
if [ -d "$web_dir/private/nodeapp" ] && [ -f "$web_dir/private/nodeapp/package.json" ]; then
    echo "Consolidating files from private/nodeapp to public_html..."
    cp -r "$web_dir/private/nodeapp"/* "$app_dir/" 2>/dev/null || true
    [ -f "$web_dir/private/nodeapp/.env" ] && cp "$web_dir/private/nodeapp/.env" "$app_dir/" 2>/dev/null || true
    rm -rf "$web_dir/private/nodeapp" 2>/dev/null || true
fi

# Remove any static index.html from public_html so Nginx NEVER blocks Node.js
rm -f "$app_dir/index.html" "$app_dir/index.htm" 2>/dev/null || true

#----------------------------------------------------------#
#              Step 3: Starter Boilerplate                 #
#----------------------------------------------------------#

if [ ! -f "$app_dir/package.json" ]; then
    case "$app_template" in
        fastify)
            if [ -d "$starters_dir/fastify" ]; then
                cp -r "$starters_dir/fastify/"* "$app_dir/"
            else
                cat <<'EOF' > "$app_dir/package.json"
{
  "name": "fastify-app",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": { "start": "node app.js" },
  "dependencies": { "dotenv": "^16.4.5", "fastify": "^4.26.2" }
}
EOF
                cat <<EOF > "$app_dir/app.js"
require('dotenv').config();
const fastify = require('fastify')({ logger: true });
const PORT = parseInt(process.env.PORT || '$port', 10);
fastify.get('/health', async () => ({ status: 'healthy', uptime: process.uptime() }));
fastify.get('/api/status', async () => ({ app: '$app_name', port: PORT, status: 'online' }));
fastify.get('/', async () => ({ message: 'Fastify running on HestiaCP', port: PORT }));
fastify.listen({ port: PORT, host: '127.0.0.1' });
EOF
            fi
            ;;

        minimal)
            if [ -d "$starters_dir/minimal" ]; then
                cp -r "$starters_dir/minimal/"* "$app_dir/"
            else
                cat <<'EOF' > "$app_dir/package.json"
{
  "name": "minimal-app",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": { "start": "node app.js" }
}
EOF
                cat <<EOF > "$app_dir/app.js"
const http = require('http');
const PORT = parseInt(process.env.PORT || '$port', 10);
const server = http.createServer((req, res) => {
  res.writeHead(200, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify({ app: '$app_name', port: PORT, status: 'online' }));
});
server.listen(PORT, '127.0.0.1');
EOF
            fi
            ;;

        blank)
            if [ ! -f "$app_dir/$startup_file" ]; then
                cat <<'EOF' > "$app_dir/package.json"
{
  "name": "custom-node-app",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": { "start": "node app.js" }
}
EOF
                cat <<EOF > "$app_dir/$startup_file"
const http = require('http');
const PORT = parseInt(process.env.PORT || '$port', 10);
http.createServer((req, res) => {
    res.writeHead(200, { 'Content-Type': 'text/plain' });
    res.end('Node.js app running on port ' + PORT);
}).listen(PORT, '127.0.0.1');
EOF
            fi
            ;;

        express|*)
            if [ -d "$starters_dir/express" ]; then
                cp -r "$starters_dir/express/"* "$app_dir/"
            else
                cat <<'EOF' > "$app_dir/package.json"
{
  "name": "express-app",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": { "start": "node app.js" },
  "dependencies": { "dotenv": "^16.4.5", "express": "^4.19.2" }
}
EOF
                cat <<EOF > "$app_dir/app.js"
require('dotenv').config();
const express = require('express');
const app = express();
const PORT = parseInt(process.env.PORT || '$port', 10);
app.get('/health', (req, res) => res.json({ status: 'healthy', uptime: process.uptime() }));
app.get('/api/status', (req, res) => res.json({ app: '$app_name', port: PORT, status: 'online' }));
app.get('/', (req, res) => res.send('<h1>🚀 Node.js App on HestiaCP</h1><p>Port: ' + PORT + '</p>'));
app.listen(PORT, '127.0.0.1');
EOF
            fi
            ;;
    esac
fi

# Ensure startup file exists if different name specified
if [ ! -f "$app_dir/$startup_file" ] && [ -f "$app_dir/app.js" ]; then
    if [ "$startup_file" != "app.js" ]; then
        mv "$app_dir/app.js" "$app_dir/$startup_file"
    fi
fi

# Clean up legacy path references and update default starter if present
if [ -f "$app_dir/$startup_file" ]; then
    if grep -q "private/nodeapp" "$app_dir/$startup_file" 2>/dev/null; then
        # If it's the boilerplate app.js, upgrade to the latest beautiful v1.0 (APA) starter
        if grep -q "HestiaCP" "$app_dir/$startup_file" 2>/dev/null && [ -f "$starters_dir/express/app.js" ]; then
            cp "$starters_dir/express/app.js" "$app_dir/$startup_file"
        else
            sed -i 's|private/nodeapp|public_html|g' "$app_dir/$startup_file" 2>/dev/null || true
        fi
    fi
fi

# Remove any static index.html that could have been in the starter
rm -f "$app_dir/index.html" "$app_dir/index.htm" 2>/dev/null || true

#----------------------------------------------------------#
#              Step 4: Environment (.env)                  #
#----------------------------------------------------------#

if [ ! -f "$app_dir/.env" ]; then
    cat <<EOF > "$app_dir/.env"
PORT=$port
NODE_ENV=$node_env
DOMAIN=$domain
APP_NAME=$app_name
EOF
else
    # Keep PORT, DOMAIN, APP_NAME in sync with configured domain parameters
    if grep -q "^PORT=" "$app_dir/.env"; then
        sed -i "s/^PORT=.*/PORT=$port/" "$app_dir/.env"
    else
        echo "PORT=$port" >> "$app_dir/.env"
    fi
    if grep -q "^DOMAIN=" "$app_dir/.env"; then
        sed -i "s/^DOMAIN=.*/DOMAIN=$domain/" "$app_dir/.env"
    else
        echo "DOMAIN=$domain" >> "$app_dir/.env"
    fi
    if grep -q "^APP_NAME=" "$app_dir/.env"; then
        sed -i "s/^APP_NAME=.*/APP_NAME=$app_name/" "$app_dir/.env"
    else
        echo "APP_NAME=$app_name" >> "$app_dir/.env"
    fi
fi

#----------------------------------------------------------#
#              Step 5: Ecosystem File (PM2)                #
#----------------------------------------------------------#

exec_mode="fork"
instances_js=1

if [ "$instances" = "max" ]; then
    exec_mode="cluster"
    instances_js="'max'"
elif [ "$instances" -gt 1 ] 2>/dev/null; then
    exec_mode="cluster"
    instances_js="$instances"
else
    exec_mode="fork"
    instances_js=1
    instances=1
fi

cat <<EOF > "$app_dir/ecosystem.config.cjs"
module.exports = {
  apps: [
    {
      name: '$app_name',
      script: '$startup_file',
      cwd: '$app_dir',
      instances: $instances_js,
      exec_mode: '$exec_mode',
      autorestart: true,
      watch: false,
      max_memory_restart: '500M',
      env: {
        NODE_ENV: '$node_env',
        PORT: $port,
        DOMAIN: '$domain',
        APP_NAME: '$app_name'
      },
      error_file: '$logs_dir/$app_name-error.log',
      out_file: '$logs_dir/$app_name-out.log',
      log_date_format: 'YYYY-MM-DD HH:mm:ss Z',
      merge_logs: true
    }
  ]
};
EOF

# Also provide ecosystem.config.js for backward compatibility
cp "$app_dir/ecosystem.config.cjs" "$app_dir/ecosystem.config.js"

#----------------------------------------------------------#
#          Step 6: Package Manager & Dependencies          #
#----------------------------------------------------------#

cat <<EOF > "$app_dir/.npmrc"
shamefully-hoist=true
strict-peer-dependencies=false
EOF

if [ -f "$app_dir/package.json" ]; then
    case "$pkg_mgr" in
        pnpm)
            if ! command -v pnpm >/dev/null 2>&1; then
                npm install -g pnpm --loglevel=error >/dev/null 2>&1 || true
            fi
            if command -v pnpm >/dev/null 2>&1; then
                echo "Installing dependencies using pnpm for $app_name in $app_dir..."
                su - "$user" -s /bin/bash -c "cd '$app_dir' && pnpm install --prod" >/dev/null 2>&1 || true
            else
                echo "Falling back to npm install for $app_name..."
                su - "$user" -s /bin/bash -c "cd '$app_dir' && npm install --no-audit --no-fund" >/dev/null 2>&1 || true
            fi
            ;;
        yarn)
            if ! command -v yarn >/dev/null 2>&1; then
                npm install -g yarn --loglevel=error >/dev/null 2>&1 || true
            fi
            su - "$user" -s /bin/bash -c "cd '$app_dir' && yarn install --production" >/dev/null 2>&1 || true
            ;;
        npm|*)
            if command -v npm >/dev/null 2>&1; then
                echo "Installing dependencies using npm for $app_name in $app_dir..."
                su - "$user" -s /bin/bash -c "cd '$app_dir' && npm install --no-audit --no-fund" >/dev/null 2>&1 || true
            fi
            ;;
    esac
fi

# Set proper ownership and permissions for domain files
chown -R "$user:$user" "$app_dir" "$conf_dir"
chmod 751 "$web_dir"
chmod -R 755 "$app_dir"

#----------------------------------------------------------#
#          Step 7: PM2 Service & Single Instance Start     #
#----------------------------------------------------------#

if command -v pm2 >/dev/null 2>&1; then
    # Ensure systemd service is active for this user
    pm2 startup systemd -u "$user" --hp "/home/$user" >/dev/null 2>&1 || true
    systemctl enable "pm2-$user" >/dev/null 2>&1 || true
    systemctl start "pm2-$user" >/dev/null 2>&1 || true

    if [ "$auto_start" = "yes" ]; then
        echo "Starting PM2 application '$app_name' (single process in $exec_mode mode)..."
        # Always delete any existing process with this app name first to prevent duplicate instances
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && pm2 delete '$app_name' 2>/dev/null || true"
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && pm2 delete 'node-$domain' 2>/dev/null || true"
        # Start fresh single instance from public_html
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && cd '$app_dir' && pm2 start ecosystem.config.cjs"
        # Persist PM2 list
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && pm2 save"
    fi
fi

#----------------------------------------------------------#
#              Step 8: Rebuild & Reload Nginx              #
#----------------------------------------------------------#

if [ -x "/usr/local/hestia/bin/v-rebuild-web-domain" ]; then
    /usr/local/hestia/bin/v-rebuild-web-domain "$user" "$domain" "no" >/dev/null 2>&1 || true
fi

if systemctl is-active --quiet nginx; then
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
fi

echo "Success: Node.js application '$app_name' installed in $app_dir, mapped to port $port with PM2."
exit 0
