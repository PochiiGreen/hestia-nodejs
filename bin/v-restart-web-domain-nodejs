#!/bin/bash
# info: restart nodejs pm2 app for a web domain
# options: USER DOMAIN [APP_NAME]
#
# author: pochii-dev / PochiiGreen (https://github.com/PochiiGreen)
# example: v-restart-web-domain-nodejs admin example.com

user="$1"
domain="$2"
app_name="$3"

if [ -z "$user" ] || [ -z "$domain" ]; then
    echo "Error: USER and DOMAIN are required."
    echo "Usage: v-restart-web-domain-nodejs USER DOMAIN [APP_NAME]"
    exit 1
fi

doc_root="/home/$user/web/$domain/public_html"
app_dir="/home/$user/web/$domain/private/nodeapp"

if [ -z "$app_name" ]; then
    if [ -f "$doc_root/ecosystem.config.cjs" ]; then
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && cd '$doc_root' && pm2 restart ecosystem.config.cjs --update-env"
    elif [ -f "$doc_root/ecosystem.config.js" ]; then
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && cd '$doc_root' && pm2 restart ecosystem.config.js --update-env"
    elif [ -f "$app_dir/ecosystem.config.cjs" ]; then
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && cd '$app_dir' && pm2 restart ecosystem.config.cjs --update-env"
    elif [ -f "$app_dir/ecosystem.config.js" ]; then
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && cd '$app_dir' && pm2 restart ecosystem.config.js --update-env"
    else
        app_name="node-$domain"
        su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && pm2 restart '$app_name' --update-env"
    fi
else
    su - "$user" -s /bin/bash -c "export PM2_HOME=/home/$user/.pm2 && pm2 restart '$app_name' --update-env"
fi

exit $?
